{
  "name": "@hr/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "//dev": "tsx/esbuild does NOT emit design:paramtypes, so Nest constructor injection silently resolves to undefined. Dev must compile with real tsc.",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch --env-file=.env.development dist/main.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "db:migrate": "tsx src/db/migrate.ts",
    "hr": "tsx src/cli/hr.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "csv-parse": "^5.6.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "smtp-server": "^3.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
