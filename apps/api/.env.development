# Local development only. Loaded by `pnpm dev` via node --env-file.
#
# Committed on purpose: every value here is a throwaway credential for the
# containers in docker-compose.dev.yml, and they are already written in plain
# text in that file and in ops/postgres/init-dev/00-roles.sh. Having them here
# means `pnpm dev` works from a clean checkout instead of failing with a
# configuration error that every new contributor has to debug once.
#
# NEVER add a real secret to this file. Production values are generated into
# the root .env by ops/deploy/install.sh, which is gitignored.

# 3100, not Node's conventional 3000. That port is contested on any machine
# running more than one project, and a collision there is not a clean
# failure -- Vite proxies /api to whatever answers, so the symptom is the
# HR app receiving another application's replies.
#
# Only local development moves. In the containers the API still listens on
# 3000, which is never published to the host (docker-compose uses `expose`,
# not `ports`) and is reached by Caddy as api:3000.
PORT=3100

# The application role — not the migrator. RLS must apply in development too,
# or the first time anyone sees a policy failure will be in production.
DATABASE_URL=postgres://hr_app:devapp@127.0.0.1:15432/hr

# Dev Keycloak runs in start-dev mode with no relative path, so the issuer has
# no /auth prefix — unlike production. See docker-compose.dev.yml.
OIDC_ISSUER_URL=http://localhost:8080/realms/hr
OIDC_AUDIENCE=hr-system

# Mailpit. Catches everything, delivers nothing: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_IGNORE_TLS=true
MAIL_FROM=HR System <no-reply@localhost>

LOG_LEVEL=debug
