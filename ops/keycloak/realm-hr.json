{
  "realm": "hr",
  "enabled": true,
  "displayName": "HR System",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "clients": [
    {
      "clientId": "hr-system",
      "name": "HR System SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://localhost:5273/*",
        "http://127.0.0.1:5273/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:4173",
        "http://localhost:5273",
        "http://127.0.0.1:5273"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5273/*##http://127.0.0.1:5273/*##http://localhost:5173/*##http://localhost:4173/*"
      },
      "fullScopeAllowed": true,
      "description": "SPA client. The 'basic' default scope is REQUIRED: since Keycloak 24 it carries the 'sub' claim, and the API resolves employees by token subject. Dropping it yields tokens with no subject and every request 401s.",
      "defaultClientScopes": [
        "basic",
        "acr",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "hr-system-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hr-system",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
