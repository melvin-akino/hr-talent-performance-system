# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 32

# --- Public addressing -------------------------------------------------
# Internal hostname staff will use. Must match the TLS certificate.
PUBLIC_HOST=hr.office.local
PUBLIC_URL=https://hr.office.local
KEYCLOAK_PUBLIC_URL=https://hr.office.local

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=hr
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Application role. Runs with RLS enforced; owns nothing.
POSTGRES_APP_USER=hr_app
POSTGRES_APP_PASSWORD=
# Migration role. Owns the schema. Used only by `pnpm db:migrate`.
POSTGRES_MIGRATOR_USER=hr_migrator
POSTGRES_MIGRATOR_PASSWORD=

# --- Keycloak ----------------------------------------------------------
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=hr
OIDC_AUDIENCE=hr-system

# --- App ---------------------------------------------------------------
LOG_LEVEL=info
